{
  "name": "shapeoko-controller",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "TypeScript monorepo for the Shapeoko Pro XXL controller (sender core, protocol contract, and kiosk UI).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/protocol",
    "packages/sender-core",
    "packages/ui"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/package.json\" \"packages/*/tsconfig.json\" package.json tsconfig.base.json eslint.config.js vitest.config.ts .prettierrc.json",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/package.json\" \"packages/*/tsconfig.json\" package.json tsconfig.base.json eslint.config.js vitest.config.ts .prettierrc.json",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  }
}
